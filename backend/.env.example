# Copy to .env (git-ignored) and fill in.

# Supabase project (Project Settings → API).
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# Mail account that sends OTPs and filter results (nodemailer).
EMAIL_SERVICE=outlook365
EMAIL_USER=you@example.com
EMAIL_PASS=your-mail-password

# Optional second account, tried when sending through the first one fails.
# EMAIL_FALLBACK_USER=
# EMAIL_FALLBACK_PASS=

# Port the API listens on (default 3005).
# PORT=3005
