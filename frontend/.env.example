# Copy to .env.local (git-ignored) and fill in.

# Google Maps JavaScript API key. Restrict it to your site's domain in the Google Cloud console.
REACT_APP_GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# Base URL of the backend in ../backend (default http://localhost:3005).
# REACT_APP_SERVER_URL=http://localhost:3005
